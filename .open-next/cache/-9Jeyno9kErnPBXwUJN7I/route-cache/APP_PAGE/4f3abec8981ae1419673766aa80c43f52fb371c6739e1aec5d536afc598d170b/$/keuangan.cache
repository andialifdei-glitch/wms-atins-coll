{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/keuangan/layout,_N_T_/keuangan/page,_N_T_/keuangan"},"segmentPaths":["/_tree","/_full","/keuangan/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/4f3abec8981ae1419673766aa80c43f52fb371c6739e1aec5d536afc598d170b/$/keuangan","owner":{"kind":"APP_PAGE","sourceRoute":"/keuangan/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"id\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/3248b8957b36a800.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-07c1ea1b9187287f.js\"/><script src=\"/_next/static/chunks/4bd1b696-8a4ab4fdf0ae305a.js\" async=\"\"></script><script src=\"/_next/static/chunks/3794-83acfce05009cf38.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-fa1b1c84bbb7748e.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/keuangan/page-dc164d5261433528.js\" async=\"\"></script><title>Emir Cell &amp; Atin Group - WMS &amp; Konter</title><meta name=\"description\" content=\"Business Control Center Integrated System\"/><link rel=\"icon\" href=\"/favicon.ico?53bff64b5ac6e5a3\" type=\"image/x-icon\" sizes=\"32x32\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"antialiased bg-[#FDF8F9]\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"space-y-6\"><div class=\"pb-4 border-b border-slate-800\"><h1 class=\"text-2xl font-bold text-white tracking-tight\">Keuangan, Saldo &amp; Piutang</h1><p class=\"text-sm text-slate-400 mt-1\">Pengawasan kas laci, rekening bank, deposit server PPOB, dan pelunasan piutang pelanggan.</p></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\"><div class=\"bg-slate-800/80 border border-slate-700/80 rounded-xl p-5 shadow-sm\"><div class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">Kas Laci Konter</div><div class=\"text-2xl font-bold text-white mt-2\">Rp <!-- -->1.250.000</div><div class=\"text-xs text-cyan-400 mt-1 font-mono\"></div></div><div class=\"bg-slate-800/80 border border-slate-700/80 rounded-xl p-5 shadow-sm\"><div class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">BCA Konter</div><div class=\"text-2xl font-bold text-white mt-2\">Rp <!-- -->4.500.000</div><div class=\"text-xs text-cyan-400 mt-1 font-mono\"></div></div><div class=\"bg-slate-800/80 border border-slate-700/80 rounded-xl p-5 shadow-sm\"><div class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">QRIS Kasir</div><div class=\"text-2xl font-bold text-white mt-2\">Rp <!-- -->850.000</div><div class=\"text-xs text-cyan-400 mt-1 font-mono\"></div></div></div><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6\"><div class=\"bg-slate-800/80 border border-slate-700/80 rounded-xl p-5 shadow-sm\"><h2 class=\"text-base font-semibold text-white mb-3\">Top Up / Rekonsiliasi Saldo Provider</h2><form class=\"space-y-4\"><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Pilih Provider</label><select class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white\"><option value=\"prov-1\" selected=\"\">Digipos / Telkomsel<!-- --> (Saldo: Rp <!-- -->450.000<!-- -->)</option><option value=\"prov-2\">DANA Bisnis<!-- --> (Saldo: Rp <!-- -->1.200.000<!-- -->)</option><option value=\"prov-3\">OVO Merchant<!-- --> (Saldo: Rp <!-- -->300.000<!-- -->)</option></select></div><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Sumber Dana Kas/Bank</label><select class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white\"><option value=\"kas-1\" selected=\"\">Kas Laci Konter<!-- --> (Sisa: Rp <!-- -->1.250.000<!-- -->)</option><option value=\"kas-2\">BCA Konter<!-- --> (Sisa: Rp <!-- -->4.500.000<!-- -->)</option><option value=\"kas-3\">QRIS Kasir<!-- --> (Sisa: Rp <!-- -->850.000<!-- -->)</option></select></div><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Nominal Tambah Saldo (Rp)</label><input type=\"number\" class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-semibold text-emerald-400\" required=\"\" value=\"500000\"/></div><button type=\"submit\" class=\"w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg text-sm shadow-md\">Simpan Penambahan Saldo</button></form></div><div class=\"bg-slate-800/80 border border-slate-700/80 rounded-xl p-5 shadow-sm\"><h2 class=\"text-base font-semibold text-white mb-3\">Pencatatan Bayar Piutang / Bon</h2><form class=\"space-y-4\"><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Pilih Pelanggan</label><select class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white\"><option value=\"\" selected=\"\">-- Pilih Pelanggan --</option><option value=\"plg-2\">Pak RT 04<!-- --> (Hutang: Rp <!-- -->45.000<!-- -->)</option></select></div><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Nominal Pembayaran Diterima (Rp)</label><input type=\"number\" class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-semibold text-cyan-400\" required=\"\" value=\"0\"/></div><button type=\"submit\" disabled=\"\" class=\"w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 disabled:bg-slate-700 text-white font-semibold rounded-lg text-sm shadow-md\">Catat Pelunasan Masuk ke Kas</button></form></div></div><div class=\"bg-slate-800/80 border border-slate-700/80 rounded-xl p-5 shadow-sm\"><h2 class=\"text-base font-semibold text-white mb-4\">Daftar Piutang Pelanggan Aktif</h2><div class=\"overflow-x-auto\"><table class=\"w-full text-left text-sm text-slate-300\"><thead class=\"bg-slate-900/60 text-xs uppercase text-slate-400\"><tr><th class=\"px-4 py-3\">Nama Pelanggan</th><th class=\"px-4 py-3\">No. WhatsApp / HP</th><th class=\"px-4 py-3\">Catatan</th><th class=\"px-4 py-3\">Sisa Piutang</th><th class=\"px-4 py-3\">Status</th></tr></thead><tbody class=\"divide-y divide-slate-700/60\"><tr class=\"hover:bg-slate-750\"><td class=\"px-4 py-3 font-medium text-white\">Umum / Walk-in</td><td class=\"px-4 py-3 font-mono text-xs text-cyan-300\">-</td><td class=\"px-4 py-3 text-xs text-slate-400\">-</td><td class=\"px-4 py-3 font-bold text-rose-400\">Rp <!-- -->0</td><td class=\"px-4 py-3\"><span class=\"px-2 py-0.5 text-[11px] rounded font-medium bg-emerald-500/20 text-emerald-300\">Lunas</span></td></tr><tr class=\"hover:bg-slate-750\"><td class=\"px-4 py-3 font-medium text-white\">Pak RT 04</td><td class=\"px-4 py-3 font-mono text-xs text-cyan-300\">081234567890</td><td class=\"px-4 py-3 text-xs text-slate-400\">-</td><td class=\"px-4 py-3 font-bold text-rose-400\">Rp <!-- -->45.000</td><td class=\"px-4 py-3\"><span class=\"px-2 py-0.5 text-[11px] rounded font-medium bg-rose-500/20 text-rose-300 border border-rose-500/30\">Belum Lunas</span></td></tr></tbody></table></div></div></div><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-07c1ea1b9187287f.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[57121,[],\\\"\\\"]\\n3:I[74581,[],\\\"\\\"]\\n4:I[61304,[],\\\"ClientPageRoot\\\"]\\n5:I[53850,[\\\"9765\\\",\\\"static/chunks/app/keuangan/page-dc164d5261433528.js\\\"],\\\"default\\\"]\\n8:I[90484,[],\\\"OutletBoundary\\\"]\\n9:\\\"$Sreact.suspense\\\"\\nc:I[90484,[],\\\"ViewportBoundary\\\"]\\ne:I[90484,[],\\\"MetadataBoundary\\\"]\\n10:I[27123,[],\\\"default\\\",1]\\n:HL[\\\"/_next/static/css/3248b8957b36a800.css\\\",\\\"style\\\"]\\nb:X\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\"