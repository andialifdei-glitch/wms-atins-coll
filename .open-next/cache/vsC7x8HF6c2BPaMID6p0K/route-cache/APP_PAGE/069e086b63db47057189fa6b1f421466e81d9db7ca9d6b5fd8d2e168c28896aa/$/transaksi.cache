{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/transaksi/layout,_N_T_/transaksi/page,_N_T_/transaksi"},"segmentPaths":["/_tree","/_full","/transaksi/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/069e086b63db47057189fa6b1f421466e81d9db7ca9d6b5fd8d2e168c28896aa/$/transaksi","owner":{"kind":"APP_PAGE","sourceRoute":"/transaksi/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"id\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/3248b8957b36a800.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-315382d12fa5adbd.js\"/><script src=\"/_next/static/chunks/4bd1b696-8a4ab4fdf0ae305a.js\" async=\"\"></script><script src=\"/_next/static/chunks/3794-83acfce05009cf38.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-fa1b1c84bbb7748e.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/transaksi/page-35c40e0ef62800a4.js\" async=\"\"></script><title>Emir Cell &amp; Atin Group - WMS &amp; Konter</title><meta name=\"description\" content=\"Business Control Center Integrated System\"/><link rel=\"icon\" href=\"/favicon.ico?53bff64b5ac6e5a3\" type=\"image/x-icon\" sizes=\"32x32\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"antialiased bg-[#FDF8F9]\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"space-y-6\"><div class=\"pb-4 border-b border-slate-800\"><h1 class=\"text-2xl font-bold text-white tracking-tight\">Kasir &amp; Riwayat Transaksi PPOB</h1><p class=\"text-sm text-slate-400 mt-1\">Pencatatan langsung penjualan pulsa, paket data, token PLN, e-wallet, dan barang fisik.</p></div><div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\"><div class=\"lg:col-span-2 bg-slate-800/80 border border-slate-700/80 rounded-xl p-5 shadow-sm\"><h2 class=\"text-base font-semibold text-white mb-4\">Input Penjualan / Transaksi</h2><form class=\"space-y-4\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Pilih Produk / Layanan</label><select class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500\"></select></div><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Nomor Tujuan / No Meter PLN</label><input type=\"text\" placeholder=\"0812xxx atau 1428xxx\" class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500 font-mono\" required=\"\" value=\"\"/></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Nama Pelanggan (Opsional)</label><input type=\"text\" placeholder=\"Contoh: Pak RT / Bu Siti\" class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500\" value=\"\"/></div><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Pilih Pelanggan Terdaftar</label><select class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500\"><option value=\"\" selected=\"\">-- Pelanggan Umum --</option><option value=\"plg-1\">Umum / Walk-in<!-- --> (<!-- -->-<!-- -->) - Piutang: Rp <!-- -->0</option><option value=\"plg-2\">Pak RT 04<!-- --> (<!-- -->081234567890<!-- -->) - Piutang: Rp <!-- -->45.000</option></select></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Metode Pembayaran</label><select class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500\"><option value=\"CASH\" selected=\"\">Tunai (Cash Kasir)</option><option value=\"TRANSFER\">Transfer Bank</option><option value=\"QRIS\">QRIS Merchant</option><option value=\"PIUTANG\">Hutang / Piutang Pelanggan (Bon)</option></select></div><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Masuk ke Kas / Rekening</label><select class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500\"><option value=\"kas-1\" selected=\"\">Kas Laci Konter<!-- --> (Saldo: Rp <!-- -->1.250.000<!-- -->)</option><option value=\"kas-2\">BCA Konter<!-- --> (Saldo: Rp <!-- -->4.500.000<!-- -->)</option><option value=\"kas-3\">QRIS Kasir<!-- --> (Saldo: Rp <!-- -->850.000<!-- -->)</option></select></div></div><button type=\"submit\" class=\"w-full mt-2 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg shadow-md transition-all flex items-center justify-center gap-2\"><span>⚡</span> Proses Transaksi Sekarang</button></form></div><div class=\"bg-slate-800/80 border border-slate-700/80 rounded-xl p-5 shadow-sm flex flex-col justify-between\"><div><h2 class=\"text-base font-semibold text-white mb-3\">Ringkasan Tagihan</h2><div class=\"space-y-3 text-sm text-slate-300\"><div class=\"flex justify-between pb-2 border-b border-slate-700\"><span class=\"text-slate-400\">Produk</span><span class=\"font-medium text-white\">-</span></div><div class=\"flex justify-between pb-2 border-b border-slate-700\"><span class=\"text-slate-400\">Harga Modal</span><span class=\"font-medium\">Rp <!-- -->0</span></div><div class=\"flex justify-between pb-2 border-b border-slate-700\"><span class=\"text-slate-400\">Harga Jual Konsumen</span><span class=\"font-bold text-emerald-400 text-lg\">Rp <!-- -->0</span></div><div class=\"flex justify-between pb-2 border-b border-slate-700\"><span class=\"text-slate-400\">Estimasi Laba Transaksi</span><span class=\"font-semibold text-cyan-400\">Rp <!-- -->0</span></div><div class=\"flex justify-between\"><span class=\"text-slate-400\">Tipe Produk</span><span class=\"px-2 py-0.5 text-xs bg-slate-700 rounded text-slate-200\">-</span></div></div></div><div class=\"mt-6 pt-4 border-t border-slate-700 text-center text-xs text-slate-400\">Transaksi otomatis memotong deposit provider terkait secara atomik.</div></div></div><div class=\"bg-slate-800/80 border border-slate-700/80 rounded-xl p-5 shadow-sm\"><div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4\"><h2 class=\"text-base font-semibold text-white\">Daftar Transaksi</h2><input type=\"text\" placeholder=\"Cari transaksi, no HP, atau pelanggan...\" class=\"bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-white focus:outline-none focus:border-emerald-500 w-full md:w-72\" value=\"\"/></div><div class=\"overflow-x-auto\"><table class=\"w-full text-left text-sm text-slate-300\"><thead class=\"bg-slate-900/60 text-xs uppercase text-slate-400\"><tr><th class=\"px-4 py-3\">Waktu</th><th class=\"px-4 py-3\">No. Transaksi</th><th class=\"px-4 py-3\">Layanan</th><th class=\"px-4 py-3\">No. Tujuan</th><th class=\"px-4 py-3\">Pelanggan</th><th class=\"px-4 py-3\">Harga Jual</th><th class=\"px-4 py-3\">Laba</th><th class=\"px-4 py-3\">SN / Referensi</th><th class=\"px-4 py-3\">Metode</th><th class=\"px-4 py-3\">Status</th></tr></thead><tbody class=\"divide-y divide-slate-700/60\"><tr><td colSpan=\"10\" class=\"px-4 py-8 text-center text-slate-400 text-sm\">Tidak ada transaksi yang cocok dengan filter pencarian.</td></tr></tbody></table></div></div></div><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-315382d12fa5adbd.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[57121,[],\\\"\\\"]\\n3:I[74581,[],\\\