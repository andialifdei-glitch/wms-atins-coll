d grid-cols-1 lg:grid-cols-3 gap-6\"><div class=\"bg-slate-800/80 border border-slate-700/80 rounded-xl p-5 shadow-sm\"><h2 class=\"text-base font-semibold text-white mb-4\">Catat Pengeluaran Baru</h2><form class=\"space-y-4\"><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Kategori Biaya</label><select class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white\"><option value=\"LISTRIK_INTERNET\" selected=\"\">Listrik &amp; Internet</option><option value=\"SEWA_TEMPAT\">Sewa Tempat / Kios</option><option value=\"GAJI_KARYAWAN\">Gaji / Insentif Karyawan</option><option value=\"KONSUMSI\">Konsumsi &amp; Operasional Harian</option><option value=\"PERLENGKAPAN\">Perlengkapan &amp; Alat Tulis</option><option value=\"LAINNYA\">Lain-lain</option></select></div><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Nominal (Rp)</label><input type=\"number\" class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white font-semibold text-rose-400\" required=\"\" value=\"50000\"/></div><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Potong dari Kas</label><select class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white\"><option value=\"kas-1\" selected=\"\">Kas Laci Konter<!-- --> (Sisa: Rp <!-- -->1.250.000<!-- -->)</option><option value=\"kas-2\">BCA Konter<!-- --> (Sisa: Rp <!-- -->4.500.000<!-- -->)</option><option value=\"kas-3\">QRIS Kasir<!-- --> (Sisa: Rp <!-- -->850.000<!-- -->)</option></select></div><div><label class=\"block text-xs font-medium text-slate-300 mb-1\">Keterangan Pengeluaran</label><input type=\"text\" placeholder=\"Contoh: Beli token listrik konter 50rb\" class=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white\" required=\"\" value=\"\"/></div><button type=\"submit\" class=\"w-full py-2.5 bg-rose-600 hover:bg-rose-500 text-white font-semibold rounded-lg text-sm sha