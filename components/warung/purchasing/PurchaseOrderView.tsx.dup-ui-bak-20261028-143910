"use client";

import React, { useEffect, useState } from "react";
import WarungDataTable, { type Column } from "@/components/warung/shared/WarungDataTable";
import WarungModal from "@/components/warung/shared/WarungModal";
import WarungSearchInput from "@/components/warung/shared/WarungSearchInput";

interface PoItem {
  productCode: string;
  productName: string;
  qty: number;
  cost: number;
  subtotal: number;
}

interface Po {
  poId: string;
  supplierCode: string;
  supplierName: string;
  orderDate: string;
  expectedDate: string;
  status: string;
  items: PoItem[];
  totalAmount: number;
  notes: string;
  createdAt: string;
  createdBy: string;
}

interface Supplier { supplierCode: string; supplierName: string; active: boolean; }
interface Product { productCode: string; name: string; capitalPrice: number; unit: string; }

const fmtRp = (n: number) => "Rp " + (n || 0).toLocaleString("id-ID");

export default function PurchaseOrderView() {
  const [items, setItems] = useState<Po[]>([]);
  const [suppliers, setSuppliers] = useState<Supplier[]>([]);
  const [products, setProducts] = useState<Product[]>([]);
  const [loading, setLoading] = useState(false);
  const [q, setQ] = useState("");
  const [filterStatus, setFilterStatus] = useState("");
  const [msg, setMsg] = useState<{ type: "success" | "error"; text: string } | null>(null);

  const [modalOpen, setModalOpen] = useState(false);
  const [detailOpen, setDetailOpen] = useState(false);
  const [detailPo, setDetailPo] = useState<Po | null>(null);

  const [form, setForm] = useState({ supplierCode: "", orderDate: new Date().toISOString().slice(0, 10), expectedDate: "", notes: "" });
  const [formItems, setFormItems] = useState<Array<{ productCode: string; qty: number; cost: number }>>([{ productCode: "", qty: 1, cost: 0 }]);
  const [submitting, setSubmitting] = useState(false);

  async function loadRefs() {
    try {
      const [sRes, pRes] = await Promise.all([
        fetch("/api/warung/suppliers?active=true"),
        fetch("/api/warung/products?active=true"),
      ]);
      const sj = await sRes.json();
      const pj = await pRes.json();
      if (sj.success) setSuppliers(sj.data);
      if (pj.success) setProducts(pj.data);
    } catch {}
  }

  async function load() {
    setLoading(true);
    try {
      const params = new URLSearchParams();
      if (q) params.set("q", q);
      if (filterStatus) params.set("status", filterStatus);
      const res = await fetch("/api/warung/po?" + params.toString(), { cache: "no-store" });
      const j = await res.json();
      if (j.success) setItems(j.data);
      else setMsg({ type: "error", text: j.message });
    } catch (e: any) { setMsg({ type: "error", text: e.message }); }
    finally { setLoading(false); }
  }

  useEffect(() => { loadRefs(); load(); /* eslint-disable-next-line react-hooks/exhaustive-deps */ }, []);

  function openCreate() {
    setForm({ supplierCode: suppliers[0]?.supplierCode || "", orderDate: new Date().toISOString().slice(0, 10), expectedDate: "", notes: "" });
    setFormItems([{ productCode: "", qty: 1, cost: 0 }]);
    setModalOpen(true);
  }

  function updateItem(idx: number, patch: Partial<{ productCode: string; qty: number; cost: number }>) {
    setFormItems((prev) => prev.map((it, i) => i === idx ? { ...it, ...patch } : it));
  }
  function addItemRow() { setFormItems((prev) => [...prev, { productCode: "", qty: 1, cost: 0 }]); }
  function removeItemRow(idx: number) { setFormItems((prev) => prev.filter((_, i) => i !== idx)); }

  function onProductSelect(idx: number, code: string) {
    const p = products.find((x) => x.productCode === code);
    updateItem(idx, { productCode: code, cost: p?.capitalPrice || 0 });
  }

  // Total preview
  const totalPreview = formItems.reduce((acc, it) => acc + (it.qty * it.cost), 0);

  async function submit(e: React.FormEvent) {
    e.preventDefault();
    const cleaned = formItems.filter((it) => it.productCode && it.qty > 0);
    if (!form.supplierCode) { setMsg({ type: "error", text: "Supplier wajib." }); return; }
    if (cleaned.length === 0) { setMsg({ type: "error", text: "Minimal 1 item valid." }); return; }
    setSubmitting(true);
    try {
      const res = await fetch("/api/warung/po", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...form, items: cleaned }),
      });
      const j = await res.json();
      if (!j.success) { setMsg({ type: "error", text: j.message }); return; }
      setMsg({ type: "success", text: j.message });
      setModalOpen(false);
      await load();
    } catch (e: any) { setMsg({ type: "error", text: e.message }); }
    finally { setSubmitting(false); }
  }

  async function doAction(po: Po, action: "ORDER" | "CANCEL" | "DELETE") {
    if (action !== "ORDER" && !confirm(`Yakin ${action.toLowerCase()} PO ${po.poId}?`)) return;
    try {
      let res: Response;
      if (action === "DELETE") {
        res = await fetch(`/api/warung/po/${encodeURIComponent(po.poId)}`, { method: "DELETE" });
      } else {
        res = await fetch(`/api/warung/po/${encodeURIComponent(po.poId)}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action }),
        });
      }
      const j = await res.json();
      if (!j.success) { setMsg({ type: "error", text: j.message }); return; }
      setMsg({ type: "success", text: j.message });
      if (detailOpen) setDetailOpen(false);
      await load();
    } catch (e: any) { setMsg({ type: "error", text: e.message }); }
  }

  function openDetail(po: Po) { setDetailPo(po); setDetailOpen(true); }

  // WA share template — text rapi, tidak tumpang tindih
  function buildWaText(po: Po): string {
    const lines = [
      `*PURCHASE ORDER ${po.poId}*`,
      `Supplier: ${po.supplierName} (${po.supplierCode})`,
      `Tanggal Order: ${po.orderDate}`,
      po.expectedDate ? `Estimasi Terima: ${po.expectedDate}` : "",
      "",
      "*Daftar Pesanan:*",
      ...po.items.map((it, i) =>
        `${i + 1}. *${it.productName}* [${it.productCode}]\n    Qty: ${it.qty} × ${fmtRp(it.cost)} = ${fmtRp(it.subtotal)}`
      ),
      "",
      `*Total: ${fmtRp(po.totalAmount)}*`,
      po.notes ? `\nCatatan: ${po.notes}` : "",
      "",
      "Mohon dikonfirmasi ketersediaan & estimasi pengiriman.",
      "Terima kasih 🙏",
    ].filter((l) => l !== "");
    return lines.join("\n");
  }

  function shareWa(po: Po) {
    const text = buildWaText(po);
    const encoded = encodeURIComponent(text);
    window.open(`https://wa.me/?text=${encoded}`, "_blank");
  }

  async function copyWaText(po: Po) {
    try {
      await navigator.clipboard.writeText(buildWaText(po));
      setMsg({ type: "success", text: "Teks PO disalin ke clipboard — paste di WA." });
    } catch {
      setMsg({ type: "error", text: "Gagal copy. Coba klik Share WA langsung." });
    }
  }

  const statusColor = (status: string) => {
    switch (status) {
      case "DRAFT": return "bg-slate-100 text-slate-800";
      case "ORDERED": return "bg-amber-100 text-amber-800";
      case "RECEIVED": return "bg-emerald-100 text-emerald-800";
      case "CANCELLED": return "bg-rose-100 text-rose-800";
      default: return "bg-slate-100 text-slate-800";
    }
  };

  const columns: Column<Po>[] = [
    { key: "poId", label: "PO ID", render: (r) => <span className="font-mono font-bold text-slate-900">{r.poId}</span> },
    { key: "supplierName", label: "Supplier", render: (r) => <span className="text-[11px]">{r.supplierName}</span> },
    { key: "orderDate", label: "Tanggal", render: (r) => <span className="font-mono text-[10px]">{r.orderDate}</span> },
    { key: "totalAmount", label: "Total", render: (r) => <span className="font-mono font-bold text-emerald-700 text-[11px]">{fmtRp(r.totalAmount)}</span> },
    { key: "status", label: "Status", render: (r) => <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${statusColor(r.status)}`}>{r.status}</span> },
    { key: "actions", label: "Aksi", render: (r) => (
      <div className="flex flex-wrap gap-1 whitespace-nowrap">
        <button type="button" onClick={() => openDetail(r)} className="px-2 py-1 rounded bg-sky-100 hover:bg-sky-200 text-sky-800 text-[10px] font-bold">Detail</button>
        <button type="button" onClick={() => shareWa(r)} className="px-2 py-1 rounded bg-emerald-100 hover:bg-emerald-200 text-emerald-800 text-[10px] font-bold" title="Share ke WhatsApp">WA</button>
        {r.status === "DRAFT" && (
          <button type="button" onClick={() => doAction(r, "ORDER")} className="px-2 py-1 rounded bg-amber-100 hover:bg-amber-200 text-amber-800 text-[10px] font-bold">Order</button>
        )}
        {r.status !== "RECEIVED" && r.status !== "CANCELLED" && (
          <button type="button" onClick={() => doAction(r, "CANCEL")} className="px-2 py-1 rounded bg-rose-100 hover:bg-rose-200 text-rose-800 text-[10px] font-bold">Cancel</button>
        )}
        {r.status === "DRAFT" && (
          <button type="button" onClick={() => doAction(r, "DELETE")} className="px-2 py-1 rounded bg-slate-200 hover:bg-slate-300 text-slate-800 text-[10px] font-bold">Hapus</button>
        )}
      </div>
    )},
  ];

  const detailItemColumns: Column<PoItem>[] = [
    { key: "productName", label: "Produk", render: (r) => <span className="text-[11px]"><b>{r.productName}</b> <span className="text-slate-500">[{r.productCode}]</span></span> },
    { key: "qty", label: "Qty", render: (r) => <span className="font-mono">{r.qty}</span> },
    { key: "cost", label: "Harga", render: (r) => <span className="font-mono text-[11px]">{fmtRp(r.cost)}</span> },
    { key: "subtotal", label: "Subtotal", render: (r) => <span className="font-mono text-[11px]">{fmtRp(r.subtotal)}</span> },
  ];

  return (
    <div className="bg-white rounded-xl border border-slate-200 p-4 shadow-xs space-y-3.5">
      <div className="flex justify-between items-center gap-2 flex-wrap">
        <div>
          <span className="text-xs font-bold text-slate-900 uppercase">Purchase Order</span>
          <p className="text-[11px] text-slate-500">Pemesanan ke supplier</p>
        </div>
        <div className="flex gap-2 flex-wrap items-center">
          <select value={filterStatus} onChange={(e) => setFilterStatus(e.target.value)} className="px-3 py-1.5 border border-slate-300 rounded-lg text-xs">
            <option value="">Semua Status</option>
            <option value="DRAFT">DRAFT</option>
            <option value="ORDERED">ORDERED</option>
            <option value="RECEIVED">RECEIVED</option>
            <option value="CANCELLED">CANCELLED</option>
          </select>
          <WarungSearchInput value={q} onChange={setQ} placeholder="Cari PO/Supplier..." />
          <button type="button" onClick={load} className="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold">Cari</button>
          <button type="button" onClick={openCreate} className="px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white rounded-lg text-xs font-bold whitespace-nowrap">+ Buat PO</button>
        </div>
      </div>

      {msg && <div className={`p-2 rounded text-xs font-medium ${msg.type === "success" ? "bg-emerald-50 text-emerald-800 border border-emerald-200" : "bg-rose-50 text-rose-800 border border-rose-200"}`}>{msg.text}</div>}

      <WarungDataTable columns={columns} data={items} loading={loading} rowKey={(r) => r.poId} emptyMessage="Belum ada PO." />

      <WarungModal open={modalOpen} title="Buat Purchase Order" onClose={() => setModalOpen(false)} maxWidth="max-w-3xl">
        <form onSubmit={submit} className="space-y-3">
          <div className="grid grid-cols-3 gap-3">
            <div>
              <label className="block text-xs font-semibold text-slate-700 mb-1">Supplier</label>
              <select required value={form.supplierCode} onChange={(e) => setForm({ ...form, supplierCode: e.target.value })} className="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
                <option value="">-- pilih --</option>
                {suppliers.map((s) => <option key={s.supplierCode} value={s.supplierCode}>{s.supplierCode} - {s.supplierName}</option>)}
              </select>
            </div>
            <div>
              <label className="block text-xs font-semibold text-slate-700 mb-1">Tgl Order</label>
              <input type="date" value={form.orderDate} onChange={(e) => setForm({ ...form, orderDate: e.target.value })} className="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" />
            </div>
            <div>
              <label className="block text-xs font-semibold text-slate-700 mb-1">Estimasi Terima</label>
              <input type="date" value={form.expectedDate} onChange={(e) => setForm({ ...form, expectedDate: e.target.value })} className="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" />
            </div>
          </div>

          <div>
            <div className="flex justify-between items-center mb-1">
              <label className="block text-xs font-semibold text-slate-700">Item</label>
              <button type="button" onClick={addItemRow} className="px-2 py-1 rounded bg-amber-100 text-amber-800 text-[10px] font-bold">+ Baris</button>
            </div>
            <div className="space-y-2 max-h-[280px] overflow-y-auto pr-1">
              {formItems.map((it, idx) => (
                <div key={idx} className="grid grid-cols-12 gap-2 items-end border border-slate-200 rounded-lg p-2">
                  <div className="col-span-6">
                    <select value={it.productCode} onChange={(e) => onProductSelect(idx, e.target.value)} className="w-full border border-slate-300 rounded-lg px-2 py-1.5 text-xs">
                      <option value="">-- produk --</option>
                      {products.map((p) => <option key={p.productCode} value={p.productCode}>{p.productCode} - {p.name}</option>)}
                    </select>
                  </div>
                  <div className="col-span-2">
                    <input type="number" min={1} step={1} value={it.qty} onChange={(e) => updateItem(idx, { qty: Number(e.target.value) })} className="w-full border border-slate-300 rounded-lg px-2 py-1.5 text-xs" placeholder="Qty" />
                  </div>
                  <div className="col-span-3">
                    <input type="number" min={0} step={1} value={it.cost} onChange={(e) => updateItem(idx, { cost: Number(e.target.value) })} className="w-full border border-slate-300 rounded-lg px-2 py-1.5 text-xs" placeholder="Harga" />
                  </div>
                  <div className="col-span-1">
                    <button type="button" onClick={() => removeItemRow(idx)} className="w-full px-2 py-1.5 rounded bg-rose-100 text-rose-800 text-xs font-bold">×</button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div className="flex justify-between items-center border-t border-slate-200 pt-2">
            <span className="text-xs text-slate-600">Total: <b className="text-emerald-700">{fmtRp(totalPreview)}</b></span>
          </div>

          <div>
            <label className="block text-xs font-semibold text-slate-700 mb-1">Catatan</label>
            <input type="text" value={form.notes} onChange={(e) => setForm({ ...form, notes: e.target.value })} className="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" />
          </div>

          <div className="flex justify-end gap-2 pt-2">
            <button type="button" onClick={() => setModalOpen(false)} disabled={submitting} className="px-4 py-2 text-xs font-semibold text-slate-700 bg-slate-100 rounded-lg">Batal</button>
            <button type="submit" disabled={submitting} className="px-4 py-2 text-xs font-bold text-white bg-amber-600 hover:bg-amber-500 rounded-lg">{submitting ? "Menyimpan..." : "Simpan PO"}</button>
          </div>
        </form>
      </WarungModal>

      <WarungModal open={detailOpen} title={detailPo ? `PO ${detailPo.poId}` : "Detail"} onClose={() => setDetailOpen(false)} maxWidth="max-w-3xl">
        {detailPo ? (
          <div className="space-y-3">
            <div className="grid grid-cols-2 gap-2 text-xs">
              <div>Supplier: <b>{detailPo.supplierName}</b> ({detailPo.supplierCode})</div>
              <div>Status: <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${statusColor(detailPo.status)}`}>{detailPo.status}</span></div>
              <div>Tgl Order: <span className="font-mono">{detailPo.orderDate}</span></div>
              <div>Estimasi: <span className="font-mono">{detailPo.expectedDate || "-"}</span></div>
            </div>

            <div className="flex gap-2">
              <button type="button" onClick={() => shareWa(detailPo)} className="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded text-xs font-bold">Share WA</button>
              <button type="button" onClick={() => copyWaText(detailPo)} className="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-xs font-semibold">Copy Teks</button>
            </div>

            <WarungDataTable columns={detailItemColumns} data={detailPo.items} rowKey={(r) => r.productCode} emptyMessage="Tidak ada item." />

            <div className="text-right text-xs pt-2 border-t border-slate-200">
              Total: <b className="text-emerald-700 text-sm">{fmtRp(detailPo.totalAmount)}</b>
            </div>

            {detailPo.notes && <div className="text-xs text-slate-600">Catatan: {detailPo.notes}</div>}
          </div>
        ) : <div className="p-4 text-center text-slate-400 text-xs">-</div>}
      </WarungModal>
    </div>
  );
}